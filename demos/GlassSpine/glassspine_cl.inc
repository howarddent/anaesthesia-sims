    '   of it) goes to state[4+s] for `inject`, and what it adds to the running'#10 +
    '   total state[2+s]. srcCells holds sac 0''s n0 source cells then sac 1''s. */'#10 +
    '__kernel void inject_prepare(__global const int* srcCells, int n0, int n1,'#10 +
    '  __global const float* c, __global float* state, float add0, float add1, float vcell)'#10 +
    '{'#10 +
    '  if (get_global_id(0) != 0) return;'#10 +
    '  for (int s = 0; s < 2; s++)'#10 +
    '  {'#10 +
    '    int first = s ? n0 : 0;'#10 +
    '    int count = s ? n1 : n0;'#10 +
    '    float cap = 0.0f;'#10 +
    '    for (int i = 0; i < count; i++) cap += (1.0f - c[srcCells[first + i]]) * vcell;'#10 +
    '    float pending = state[s] + (s ? add1 : add0);'#10 +
    '    float f = 0.0f;'#10 +
    '    if (cap > 1e-6f && pending > 0.0f) f = fmin(1.0f, pending / cap);'#10 +
    '    state[s] = pending - f * cap;'#10 +
    '    state[2 + s] += f * cap;'#10 +
    '    state[4 + s] = f;'#10 +
    '  }'#10 +
    '}'#10 +
    ''#10 +
    '/* the injection: C -> C + f (1 - C) inside the source sphere, f from'#10 +
    '   inject_prepare */'#10 +
    '__kernel void inject(__global const int* fluid, int n, __global const uchar* fl,'#10 +
    '  __global float* c, float4 src0, float4 src1, __global const float* state)'#10 +
    '{'#10 +
    '  int g = get_global_id(0);'#10 +
    '  if (g >= n) return;'#10 +
    '  int id = fluid[g];'#10 +
    '  int s1 = (fl[id] & SAC1) != 0;'#10 +
    '  float4 src = s1 ? src1 : src0;'#10 +
    '  float f = state[4 + s1];'#10 +
    '  if (f <= 0.0f) return;'#10 +
    '  float3 d = convert_float3(cellOf(id)) - src.xyz;'#10 +
    '  if (dot(d, d) <= src.w * src.w) c[id] += f * (1.0f - c[id]);'#10 +
    '}'#10 +
    ''#10 +
    '/* the flux through each sac''s cross-section k (between slices k-1 and'#10 +
    '   k), one work-item per (sac, k), and the plug velocity that would make'#10 +
    '   it q G[s,k]: corr[s,k] = (q G - flux) / (A dx^2) */'#10 +
    '__kernel void plane_flux(__global const uchar* fl, __global const float4* v,'#10 +
    '  __global const float* G, __global const int* A, float q, float dx2,'#10 +
    '  __global float* corr, __global const float* Gi, float qi)'#10 +
    '{'#10 +
    '  int g = get_global_id(0);'#10 +
    '  if (g >= 2 * (NZ + 1)) return;'#10 +
    '  int s = g / (NZ + 1);'#10 +
    '  int k = g - s * (NZ + 1);'#10 +
    '  corr[g] = 0.0f;'#10 +
    '  if (k < 1 || k >= NZ || A[g] == 0) return;'#10 +
    '  float sum = 0.0f;'#10 +
    '  int base = k * NXY;'#10 +
    '  for (int j = 0; j < NY; j++)'#10 +
    '    for (int i = 0; i < NX; i++)'#10 +
    '    {'#10 +
    '      int id = base + j * NX + i;'#10 +
    '      uchar f = fl[id];'#10 +
    '      if (!(f & FLUID) || !(fl[id - NXY] & FLUID)) continue;'#10 +
    '      if (((f & SAC1) != 0) != (s == 1)) continue;'#10 +
    '      sum += v[id].z;'#10 +
    '    }'#10 +
    '  corr[g] = (q * G[g] + qi * Gi[g] - sum * dx2) / (A[g] * dx2);'#10 +
    '}'#10 +
    ''#10 +
    '__kernel void plane_correct(__global const int* fluid, int n, __global const uchar* fl,'#10 +
    '  __global float4* v, __global const float* corr)'#10 +
    '{'#10 +
    '  int g = get_global_id(0);'#10 +
    '  if (g >= n) return;'#10 +
    '  int id = fluid[g];'#10 +
    '  if (!(fl[id - NXY] & FLUID)) return;'#10 +
    '  int k = id / NXY;'#10 +
    '  int s = (fl[id] & SAC1) != 0;'#10 +
    '  v[id].z += corr[s * (NZ + 1) + k];'#10 +
    '}'#10;
